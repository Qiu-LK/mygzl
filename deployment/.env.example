# Copy this file to deployment/.env and fill in real values.
# Never commit deployment/.env.

# Dify core
SECRET_KEY=replace-with-a-long-random-secret
INIT_PASSWORD=replace-on-first-start
DB_PASSWORD=replace-with-a-database-password
REDIS_PASSWORD=replace-with-a-redis-password

# Select the vector store used by this installation.
VECTOR_STORE=weaviate

# Model/provider credentials (configure in Dify or here as appropriate)
OPENAI_API_KEY=
OPENAI_API_BASE=

# Workflow-specific PDF service endpoint.
PDF_RENDER_URL=http://host.docker.internal:8084/render

# Allow Dify's SSRF proxy to reach the auxiliary containers on the Compose network.
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=dify-pdf-bridge-inspect-test-v2,dify-pdf-bridge-extract-test,gotenberg

# The following services are referenced by Demo4 but their source was not found
# in the original Dify directory. The repository now provides source builds
# for both endpoints through docker-compose.pdf-services.yaml.
PDF_INSPECT_URL=http://dify-pdf-bridge-inspect-test-v2:8080/inspect
PDF_EXTRACT_URL=http://dify-pdf-bridge-extract-test:8080/extract

